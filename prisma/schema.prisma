// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  avatarUrl     String?
  name          String
  createdAt     DateTime @default(now())

  plan          String   @default("free") // free | monthly | yearly
  planRenewsAt  DateTime?
  freeSecondsLeft Int    @default(600) // 10 minute free session
  creditSeconds Int      @default(0)   // purchased/subscription seconds available

  defaultFormat     String   @default("paragraph")
  defaultTone       String   @default("professional")
  defaultLength     String   @default("balanced")
  autoAnswer        Boolean  @default(true)
  emailNotifications Boolean @default(true)
  referralCode      String?  @unique
  referredBy        String?

  resumes          Resume[]
  documents        Document[]
  sessions         CallSession[]
  transactions     CreditTransaction[]
  practiceHistory  PracticeSession[]
  stories          UserStory[]
  referralsGiven   Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String
  referred    User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  code        String
  creditsGiven Int     @default(0)
  createdAt   DateTime @default(now())
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  content   String   // extracted plain text
  createdAt DateTime @default(now())

  sessions  CallSession[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  content   String
  createdAt DateTime @default(now())
}

model CallSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   @default("interview") // interview | call
  company       String?
  role          String?
  extraContext  String?
  resumeId      String?
  resume        Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status        String   @default("active") // active | ended
  isFree        Boolean  @default(false)
  secondsUsed   Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  messages      Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // question | answer
  content   String
  createdAt DateTime @default(now())
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // purchase | usage | grant
  seconds   Int
  note      String?
  createdAt DateTime @default(now())
}

model PracticeSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  company      String?
  questionText String
  userAnswer   String?
  aiFeedback   String?
  aiScore      Int?
  duration     Int      @default(0)
  createdAt    DateTime @default(now())
}

model UserStory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  situation  String
  task       String
  action     String
  result     String
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
